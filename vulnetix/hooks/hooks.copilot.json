{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Bash",
        "type": "command",
        "bash": "./hooks/pre-commit-scan.sh",
        "timeoutSec": 30
      },
      {
        "matcher": "Edit|Write",
        "type": "command",
        "bash": "./hooks/manifest-edit-scan.sh",
        "timeoutSec": 30
      },
      {
        "matcher": "Bash",
        "type": "command",
        "bash": "./hooks/dep-install-gate.sh",
        "timeoutSec": 20
      },
      {
        "matcher": "Bash",
        "type": "command",
        "bash": "./hooks/docker-build-gate.sh",
        "timeoutSec": 30
      },
      {
        "matcher": "Bash",
        "type": "command",
        "bash": "./hooks/terraform-apply-gate.sh",
        "timeoutSec": 30
      },
      {
        "matcher": "Bash",
        "type": "command",
        "bash": "./hooks/git-push-gate.sh",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "matcher": "Bash",
        "type": "command",
        "bash": "./hooks/post-install-scan.sh",
        "timeoutSec": 120
      },
      {
        "matcher": "Edit|Write",
        "type": "command",
        "bash": "./hooks/dockerfile-edit-gate.sh",
        "timeoutSec": 10
      },
      {
        "matcher": "Edit|Write",
        "type": "command",
        "bash": "./hooks/iac-edit-gate.sh",
        "timeoutSec": 10
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": "./hooks/capabilities-detect.sh --announce",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "bash": "./hooks/session-summary.sh",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "./hooks/stop-reminder.sh",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "./hooks/vuln-context-inject.sh",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "bash": "./hooks/prompt-router.sh",
        "timeoutSec": 10
      }
    ]
  }
}
