{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./hooks/pre-commit-scan.sh"
      },
      {
        "command": "./hooks/dep-install-gate.sh"
      },
      {
        "command": "./hooks/docker-build-gate.sh"
      },
      {
        "command": "./hooks/terraform-apply-gate.sh"
      },
      {
        "command": "./hooks/git-push-gate.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": "./hooks/manifest-edit-scan.sh"
      },
      {
        "command": "./hooks/dockerfile-edit-gate.sh"
      },
      {
        "command": "./hooks/iac-edit-gate.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": "./hooks/post-install-scan.sh"
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/capabilities-detect.sh --announce"
      },
      {
        "command": "./hooks/session-summary.sh"
      }
    ],
    "stop": [
      {
        "command": "./hooks/stop-reminder.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/vuln-context-inject.sh"
      },
      {
        "command": "./hooks/prompt-router.sh"
      }
    ]
  }
}
